      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const base = $('Internal Filter Sources').first().json || {};\nlet cited = '';\nlet citeError = '';\ntry {\n  const r = $('Internal Cite Search Results').first().json || {};\n  if (r.error) citeError = 'Citation step error: ' + (typeof r.error === 'string' ? r.error : (r.error.message || JSON.stringify(r.error)));\n  cited = ((r.candidates && r.candidates[0] && r.candidates[0].content && r.candidates[0].content.parts) || []).map(p => p.text || '').join('');\n} catch (e) {}\nreturn [{ json: {\n  source: 'external_web',\n  retrieval_status: base.retrieval_status || 'failed',\n  question: base.question || '',\n  sources: base.sources || [],\n  source_urls: base.source_urls || [],\n  context: base.context || '',\n  cited_answer: cited,\n  error: [base.error, citeError].filter(Boolean).join(' | '),\n  disclaimer: 'مصادر خارجية من الويب لم يتم التحقق منها قانونياً؛ يجب مراجعتها قبل الاعتماد عليها.'\n} }];"
