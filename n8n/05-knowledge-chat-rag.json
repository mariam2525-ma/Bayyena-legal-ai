      "name": "Gemini Answer",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const p = $('Build Prompt').first().json;\nconst lang = $('Prepare Question').first().json.lang;\nconst text = ($json.candidates?.[0]?.content?.parts || []).filter(x => x.text && !x.thought).map(x => x.text).join('').trim();\nif (!text) throw new Error('Empty model answer');\nconst src = p.sources.map(s => '[' + s.n + '] ' + s.title + (s.type ? ' — ' + s.type : '')).join('\\n');\nconst head = lang === 'en' ? 'Sources from the knowledge base:' : 'المصادر من قاعدة المعرفة:';\nreturn [{ json: { final_answer: text + '\\n\\n— ' + head + '\\n' + src, source: 'knowledge_base', sources: p.sources } }];"
      },
      "name": "Format Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
