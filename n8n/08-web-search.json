    {
      "parameters": {
        "jsCode": "// لا يرمي أخطاء أبدًا: أي فشل في البحث يرجع كنتيجة \"failed\" بدل ما يوقع الـ workflow\nconst req = $('Search Request Webhook').first().json.body || {};\nconst question = String(req.question || req.message || '');\nconst p = $input.first().json || {};\nlet error = '';\nif (p.error) { const e = p.error; error = 'Serper error: ' + (typeof e === 'string' ? e : (e.message || e.status || JSON.stringify(e))); }\nconst results = Array.isArray(p.organic) ? p.organic : [];\nconst sources = results\n  .filter(r => r && typeof r.link === 'string' && r.link.startsWith('http') && !/forum|quora/i.test(r.link))\n  .slice(0, 5)\n  .map((r, i) => ({ index: i + 1, title: r.title || '', url: r.link, snippet: r.snippet || '' }));\nconst context = sources.map(s => 'المصدر [' + s.index + ']: ' + s.title + '\\nالرابط: ' + s.url + '\\nالمقتطف: ' + s.snippet).join('\\n\\n');\nreturn [{ json: { question, retrieval_status: sources.length ? 'ok' : 'failed', error, sources, source_urls: sources.map(s => s.url), context } }];"
      },
