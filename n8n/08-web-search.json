    },
    {
      "parameters": {
        "jsCode": "// Keeps only URLs actually returned by the search API. Never fabricates URLs.\nconst req = $('When Executed by Another Workflow').first().json || {};\nconst all = $input.all().map(i => i.json || {});\nconst question = String(req.question || req.query || req.message || '');\nlet error = '';\nconst errItem = all.find(p => p.error);\nif (errItem) { const e = errItem.error; error = 'Serper API error: ' + (typeof e === 'string' ? e : (e.message || e.status || JSON.stringify(e))); }\nconst results = [];\nfor (const p of all) { if (Array.isArray(p.organic)) results.push(...p.organic); else if (p.link) results.push(p); }\nconst sources = results\n  .filter(r => r && typeof r.link === 'string' && r.link.startsWith('http') && !r.link.toLowerCase().includes('forum') && !r.link.toLowerCase().includes('quora'))\n  .slice(0, 5)\n  .map((r, i) => ({ index: i + 1, title: r.title || '', url: r.link, snippet: r.snippet || '', retrieved: true, retrieved_via: 'serper_web_search' }));\nif (!error && sources.length === 0) error = 'No web results were retrieved for this query.';\nconst context = sources.map(s => 'المصدر [' + s.index + ']: ' + s.title + '\\nالرابط: ' + s.url + '\\nالمقتطف: ' + s.snippet).join('\\n\\n');\nreturn [{ json: { question, retrieval_status: sources.length ? 'ok' : 'failed', error, sources, source_urls: sources.map(s => s.url), context } }];"
      },
