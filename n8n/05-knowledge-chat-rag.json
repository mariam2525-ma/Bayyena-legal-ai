    {
      "parameters": {
        "jsCode": "const w = $('Chat Webhook').first().json.body || {};\nconst question = String(w.question || w.message || '').trim().slice(0, 1500);\nif (!question) throw new Error('Empty question');\nconst audience = w.audience === 'legal' ? 'legal' : 'general';\nconst kind = w.kind === 'research' ? 'research' : 'contract';\nconst lang = w.lang === 'en' ? 'en' : 'ar';\nconst hist = Array.isArray(w.history) ? w.history.slice(-6) : [];\nconst history_text = hist.map(h => 'س: ' + String(h.q || '').slice(0, 400) + '\\nج: ' + String(h.a || '').slice(0, 600)).join('\\n---\\n');\nreturn [{ json: { question, audience, kind, lang, history_text } }];"
      },
      "name": "Prepare Question",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://generativelanguage.googleapis.com/v1beta/models/gemini-embedding-001:embedContent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googlePalmApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { model: \"models/gemini-embedding-001\", content: { parts: [{ text: $json.question }] }, taskType: \"RETRIEVAL_QUERY\", outputDimensionality: 1536 } }}",
        "options": {
          "timeout": 120000
        }
      },
      "name": "Embed Question",
