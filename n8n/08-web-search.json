      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const f = $('Filter Sources').first().json || {};\nconst sources = f.sources || [];\nlet text = '';\ntry {\n  const r = $json || {};\n  text = ((r.candidates && r.candidates[0] && r.candidates[0].content && r.candidates[0].content.parts) || []).map(p => p.text || '').join('');\n} catch (e) {}\nif (!text) text = 'تعذّر تلخيص النتائج حاليًا. هذه المصادر التي تم العثور عليها:\\n' + sources.map(s => s.index + '. ' + s.title + ' — ' + s.url).join('\\n');\nconst disclaimer = \"\\n\\n⚠️ **تنويه:** هذه الإجابة مستخرجة من مصادر خارجية عبر الويب ولم يتم التحقق منها من قاعدة المعرفة الداخلية. يرجى مراجعة المصادر المرفقة للتأكد من الدقة.\";\nreturn [{ json: { final_answer: text + disclaimer, source: 'external_web', retrieval_status: 'ok', sources, source_urls: f.source_urls || [] } }];"
      },
