        "jsonBody": "={{ ({ contents: [{ parts: [{ text: 'أنت باحث قانوني مصري. بناءً على نتائج البحث التالية فقط، لخّص ما تقوله عن السؤال مع اقتباس المصادر برقمها (مثال: [1]). لا تذكر أي رابط أو مصدر غير وارد في النتائج.\\n\\nالنتائج:\\n' + $json.context + '\\n\\nالسؤال: ' + $json.question }] }] }) }}",
        "options": {
