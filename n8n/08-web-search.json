        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ ({ contents: [{ parts: [{ text: 'أنت باحث قانوني. بناءً على نتائج البحث التالية فقط، أجب عن السؤال مع اقتباس المصادر برقمها (مثال: [1]). لا تذكر أي رابط أو مصدر غير وارد في النتائج.\\n\\nالنتائج:\\n' + $json.context + '\\n\\nالسؤال: ' + $json.question }] }] }) }}",
        "options": {
